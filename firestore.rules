rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isMemberOfBoardData(boardData) {
      return isAuthenticated() && (
        (boardData.memberIds != null && request.auth.uid in boardData.memberIds) ||
        (boardData.creatorId != null && request.auth.uid == boardData.creatorId) ||
        (boardData.creatorEmail != null && request.auth.token.email != null && request.auth.token.email == boardData.creatorEmail) ||
        (boardData.members != null && request.auth.uid in boardData.members)
      );
    }

    function isInvitationRecipient(recipientEmail) {
      return isAuthenticated() &&
        request.auth.token.email != null &&
        recipientEmail == request.auth.token.email.lower();
    }

    function isBoardMember(boardId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/boards/$(boardId)) &&
        isMemberOfBoardData(get(/databases/$(database)/documents/boards/$(boardId)).data);
    }

    function isAcceptingInvitation(boardId) {
      let recipientEmail = request.auth.token.email.lower();
      let invitePath = /databases/$(database)/documents/invitations/$(recipientEmail)/boards/$(boardId);
      return isAuthenticated() &&
        request.auth.token.email != null &&
        exists(invitePath) &&
        get(invitePath).data.boardId == boardId &&
        get(invitePath).data.recipientEmail == recipientEmail &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberIds', 'updatedAt']) &&
        !(request.auth.uid in resource.data.memberIds) &&
        request.auth.uid in request.resource.data.memberIds &&
        request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1 &&
        request.resource.data.memberIds.hasAll(resource.data.memberIds) &&
        request.resource.data.members.size() == resource.data.members.size() + 1 &&
        request.resource.data.members.hasAll(resource.data.members) &&
        request.resource.data.members.hasAny([{
          'id': request.auth.uid,
          'name': get(invitePath).data.name,
          'email': request.auth.token.email,
          'role': get(invitePath).data.role
        }]);
    }

    // Rules for boards collection
    match /boards/{boardId} {
      // Only current members may read a board document.
      allow read: if isMemberOfBoardData(resource.data);

      // Allow create if user is authenticated and listed as member/creator
      allow create: if !request.resource.data.keys().hasAny(['invitations']) &&
        isAuthenticated() && (
        request.resource.data.creatorId == request.auth.uid ||
        (request.resource.data.memberIds != null && request.auth.uid in request.resource.data.memberIds)
      );

      // Invitees may only append themselves while consuming their invitation.
      allow update: if !request.resource.data.keys().hasAny(['invitations']) &&
        isAuthenticated() && (
        isMemberOfBoardData(resource.data) ||
        isAcceptingInvitation(boardId)
      );

      // Allow delete if member or creator
      allow delete: if isAuthenticated() && isMemberOfBoardData(resource.data);
    }

    // Invitation documents are stored outside board documents so recipients can read them
    // without gaining access to board contents.
    match /{path=**}/invitations/{recipientEmail}/boards/{invitationId} {
      allow read: if isInvitationRecipient(recipientEmail) ||
        (resource.data.boardId != null && isBoardMember(resource.data.boardId));

      allow create: if isBoardMember(invitationId) &&
        request.resource.data.id == invitationId &&
        request.resource.data.boardId == invitationId &&
        request.resource.data.recipientEmail == recipientEmail &&
        recipientEmail == recipientEmail.lower() &&
        request.resource.data.email is string &&
        request.resource.data.email.lower() == recipientEmail &&
        request.resource.data.role in ['admin', 'member'];

      allow delete: if isInvitationRecipient(recipientEmail) ||
        (resource.data.boardId != null && isBoardMember(resource.data.boardId));
    }

    // Rules for tasks collection
    match /tasks/{taskId} {
      allow read, write: if isAuthenticated() && (
        (resource != null && resource.data.memberIds != null && request.auth.uid in resource.data.memberIds) ||
        (resource != null && resource.data.boardId != null && isBoardMember(resource.data.boardId)) ||
        (request.resource != null && request.resource.data.boardId != null && isBoardMember(request.resource.data.boardId))
      );
    }
  }
}
